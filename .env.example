# Gateway 配置示例；复制后替换数据库地址、随机密钥及 SMTP 配置。
DATABASE_URL=mysql://rcm:change-me@127.0.0.1:3306/remote_code_mcp
APP_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
PUBLIC_URL=http://localhost:3000
CONSOLE_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
PORT=3000
# Console 本地开发：在 apps/console/.env.local 中设置 VITE_API_URL=http://localhost:3000。

# 邮箱激活：Server 启动时校验 SMTP 配置，不在启动时连接邮箱服务器。
# 必填：SMTP 服务器地址。
SMTP_HOST=smtp.example.com
# 可选：默认 587，配合 SMTP_SECURE=false 使用 STARTTLS。
# 使用 465 端口时请同时设置 SMTP_SECURE=true，采用隐式 TLS。
SMTP_PORT=587
SMTP_SECURE=false
# 必填：SMTP 登录账号及密码；部分服务商要求使用授权码或应用专用密码。
SMTP_USER=account@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# 可选：默认使用 SMTP_USER，必须是邮件服务商允许的发件地址。
MAIL_FROM=account@example.com
# 上方 CONSOLE_URL 用于生成激活链接，必须是收件人可以访问的控制台地址。
