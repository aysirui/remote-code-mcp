APP_SECRET=REPLACE_WITH_64_CHARACTERS_OF_CRYPTOGRAPHIC_RANDOM_TEXT
ADMIN_EMAIL=admin@example.com
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
PUBLIC_URL=https://mcp.example.com
CONSOLE_URL=https://console.example.com
# 公开官网地址，也作为企微审批结果卡的首页跳转地址。
WEBSITE_URL=https://www.example.com

# 邮箱激活：Server 启动时校验 SMTP 配置，不在启动时连接邮箱服务器。
# 必填：SMTP 服务器地址。
SMTP_HOST=smtp.example.com
# 可选：飞书审批机器人应用凭证及分享链接，三项均填写才启用。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_LINK=
# 可选：企业微信智能机器人和钉钉企业内部应用，缺少必填项则不启用。
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_BOT_LINK=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ROBOT_CODE=
DINGTALK_BOT_LINK=
# 可选：默认 587，配合 SMTP_SECURE=false 使用 STARTTLS。
# 使用 465 端口时请同时设置 SMTP_SECURE=true，采用隐式 TLS。
SMTP_PORT=587
SMTP_SECURE=false
# 必填：SMTP 登录账号及密码；部分服务商要求使用授权码或应用专用密码。
SMTP_USER=account@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# 可选：默认使用 SMTP_USER，必须是邮件服务商允许的发件地址。
MAIL_FROM=account@example.com
# 上方 CONSOLE_URL 用于生成激活链接，必须是收件人可以访问的控制台地址。
