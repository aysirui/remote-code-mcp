# 第一阶段：构建共享协议和 NestJS Server。
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml LICENSE ./
COPY packages/tsconfig packages/tsconfig
COPY apps/server/package.json apps/server/package.json
COPY apps/console/package.json apps/console/package.json
COPY apps/runtime/package.json apps/runtime/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/bot-sdk/package.json packages/bot-sdk/package.json
# 工作区安装会先链接演示命令；入口文件必须早于编译产物存在。
COPY packages/bot-sdk/bin packages/bot-sdk/bin
COPY apps/website/package.json apps/website/package.json
RUN pnpm --filter @rcm/server... install --frozen-lockfile
COPY packages/protocol packages/protocol
COPY packages/bot-sdk packages/bot-sdk
COPY apps/server apps/server
RUN pnpm --filter @rcm/server... --sort build
# 第二阶段：以非 root 账户启动，并执行现有初始化入口。
FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && useradd -r -u 10001 -m app
COPY --from=builder /app /app
COPY docker/entrypoint.server.sh /app/docker/entrypoint.server.sh
USER app
EXPOSE 3000
CMD ["sh", "/app/docker/entrypoint.server.sh"]
