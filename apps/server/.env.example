# 复制为 apps/server/.env，用于本地开发；实际 .env 已被 Git 忽略。
# 优先级：系统环境变量 > apps/server/.env > 仓库根目录 .env > 默认值。
# 数据库迁移和管理员初始化也使用相同配置，请确认连接的是测试数据库。
DATABASE_URL=mysql://rcm:change-me@127.0.0.1:3306/remote_code_mcp_test

# 必填：请替换为至少 32 个字符的随机密钥。
APP_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# 可选：服务端口和浏览器访问地址（以下为默认值）。
PORT=3000
PUBLIC_URL=http://localhost:3000
CONSOLE_URL=http://localhost:5173

# 初始化管理员时必填，此邮箱禁止普通用户注册。
ADMIN_EMAIL=admin@example.com

# 邮箱激活使用 SMTP 投递；启动时校验必填配置；不在启动时连接 SMTP。
# 465 使用隐式 TLS；587 配置 SMTP_SECURE=false，并强制 STARTTLS。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=account@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# 可选：默认使用 SMTP_USER，必须是邮件服务允许的发件地址。
MAIL_FROM=account@example.com

# 可选：三项均填写才启用飞书审批；使用已发布的企业自建应用及机器人分享链接。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_LINK=

# 可选：企业微信智能机器人的 Bot ID 和长连接 Secret；私聊链接非必填。
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_BOT_LINK=

# 可选：钉钉企业内部应用、企业 ID 和已发布的互动卡片模板。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_CARD_TEMPLATE_ID=
# 默认使用 Client ID；机器人私聊链接非必填。
DINGTALK_ROBOT_CODE=
DINGTALK_BOT_LINK=
