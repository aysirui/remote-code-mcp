{
  "name": "@rcm/server",
  "version": "0.1.0",
  "description": "Remote Code MCP 的账号、OAuth、设备连接及 MCP 服务端",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aysirui/remote-code-mcp.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/aysirui/remote-code-mcp#readme",
  "bugs": {
    "url": "https://github.com/aysirui/remote-code-mcp/issues"
  },
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "db:migrate": "drizzle-kit migrate",
    "admin:init": "pnpm build && node dist/admin-init.js"
  },
  "dependencies": {
    "@rcm/protocol": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.15.0",
    "zod": "catalog:",
    "ws": "catalog:",
    "bcryptjs": "^3.0.0",
    "jose": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "dotenv": "^17.2.0",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "^8.18.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:",
    "drizzle-kit": "^0.31.0",
    "@types/nodemailer": "^8.0.2"
  }
}
