---
import BaseLayout from '../layouts/BaseLayout.astro'

// 公开入口由构建参数控制，静态官网不依赖运行时 API。
const consoleUrl =
  import.meta.env.PUBLIC_CONSOLE_URL || (import.meta.env.DEV ? 'http://localhost:5173' : undefined)
const docsUrl = '/docs/'
const clientGuideUrl = '/docs/connect-clients.html'
const permissionsGuideUrl = '/docs/workspace-permissions.html'
const repositoryUrl = 'https://github.com/aysirui/remote-code-mcp'
// 首页展示临时 Git 工作区经 Runtime 审批写入后返回的真实差异摘录。
const demoDiff = [
  '--- a/README.md',
  '+++ b/README.md',
  '@@ -1,3 +1,5 @@',
  ' # RCM Demo',
  ' ',
  ' Run tests before submitting changes.',
  '+',
  '+通过远程 MCP 更新',
].join('\n')
// 在首页声明网站名称，使用与规范地址一致的公开首页 URL。
const websiteSchema = Astro.site && {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Remote Code MCP',
  alternateName: 'RCM',
  url: Astro.site.href,
}
const capabilities = [
  {
    index: '01',
    label: 'FILE SYSTEM',
    title: '让 AI 读懂真实项目',
    description: '读取、搜索和修改已授权工作区中的文件。精确到工作区的读写权限，源码由本机 Runtime 处理。',
    icon: 'file',
  },
  {
    index: '02',
    label: 'GIT WORKFLOW',
    title: '从理解变更到协作提交',
    description: '查看工作区状态、提交历史和代码差异。Git 写入操作由本机进行审批，不通过 Shell 绕开策略。',
    icon: 'git',
  },
  {
    index: '03',
    label: 'COMMANDS',
    title: '连接日常开发命令',
    description: '运行登记的测试、类型检查和构建命令。临时命令需本机确认，权限由用户掌控。',
    icon: 'terminal',
  },
  {
    index: '04',
    label: 'ACCESS CONTROL',
    title: '清楚知道谁能做什么',
    description: 'OAuth 客户端授权、设备身份和本地工作区策略共同生效，操作记录仅保留必要的脱敏信息。',
    icon: 'shield',
  },
]
const steps = [
  { n: '01', title: '部署并登录', detail: '自行部署 Server 与 Console，管理账号和设备授权。' },
  { n: '02', title: '连接本地设备', detail: '启动 Runtime，完成配对并选择允许访问的工作区。' },
  { n: '03', title: '连接 AI 工具', detail: '在支持的 AI 工具中添加 RCM 的 MCP Server，完成 OAuth 授权后调用开发工具。' },
]
// 客户端卡片指向对应的接入路径与兼容性验证步骤。
const clients = [
  { name: 'WorkBuddy', detail: '通过自定义连接器添加远程 MCP Server，验证 OAuth 授权与工作区读取。', href: `${clientGuideUrl}#workbuddy` },
  { name: '豆包', detail: '通过豆包开放平台的插件接入远程 MCP Server，按开发流程验证工具调用。', href: `${clientGuideUrl}#豆包` },
  { name: 'ChatGPT', detail: '在网页普通聊天中使用 RCM 插件读写文件、审阅 Git 差异，适用于具备自定义 MCP 权限的账号。', href: '/docs/connect-chatgpt.html' },
]
---
<BaseLayout
  title="Remote Code MCP — 开源通用 AI MCP 远程编码工具"
  description="Remote Code MCP（RCM）是开源、自托管的 AI MCP 远程编码工具。连接支持远程 MCP 的 AI 客户端，按授权读写本地代码、查看 Git 差异并运行测试。"
>
  {websiteSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
  <div class="page">
    <header class="header">
      <div class="container header-inner">
        <a class="wordmark" href="/" aria-label="Remote Code MCP 首页">
          <img src="/logo-square.svg" width="36" height="36" alt="" />
          <span>Remote Code <b>MCP</b></span>
        </a>
        <nav class="nav" aria-label="主导航">
          <a href="#capabilities">产品能力</a>
          <a href="#workflow">工作原理</a>
          <a href="#ai-clients">AI 工具</a>
          <a href="#security">安全设计</a>
          <a href={docsUrl}>使用文档</a>
        </nav>
        <div class="header-actions">
          <a class="github-link" href={repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label="访问 GitHub 源码仓库">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M12 .297a12 12 0 0 0-3.793 23.386c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.304-5.467-1.333-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23a11.52 11.52 0 0 1 3.003-.404c1.018.005 2.042.138 3.003.404 2.292-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.119 3.176.77.84 1.235 1.91 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.003 12.003 0 0 0 12 .297Z"/></svg>
            <span>GitHub</span>
          </a>
          {consoleUrl && <a class="header-cta" href={consoleUrl}>进入控制台 <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-background" aria-hidden="true"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <div class="pill"><span class="pill-dot"></span> OPEN SOURCE <span class="pill-divider"></span> SELF-HOSTED <span class="pill-divider"></span> MCP</div>
            <h1>让 AI 工具连接<br />你的<span>本地代码。</span></h1>
            <p class="hero-lead">RCM 是开源、自托管的通用 AI MCP 远程编码工具。让支持远程 MCP 的 AI 客户端读写已授权的工作区、查看 Git 差异，并在本机运行已登记的测试命令。</p>
            <div class="hero-buttons">
              <a class="btn btn-primary" href="#ai-clients">查看 AI 工具接入 <span aria-hidden="true">↓</span></a>
              <a class="btn btn-secondary" href="#remote-coding-demo">查看操作演示 <span aria-hidden="true">↓</span></a>
            </div>
            <div class="hero-meta"><span><i></i> 本地执行</span><span><i></i> 显式授权</span><span><i></i> 可自行部署</span></div>
          </div>
          <div class="product-visual" aria-label="AI 客户端通过 RCM Server 与本地 Runtime 交互的示意图">
            <div class="visual-top"><div class="visual-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>REMOTE CODE / CONNECTION</span><span class="visual-online"><span></span> ONLINE</span></div>
            <div class="visual-body">
              <div class="visual-intro"><div><span class="visual-eyebrow">WORKSPACE SESSION</span><strong>连接你的开发环境</strong></div><span class="visual-tag">AUTHORIZED</span></div>
              <div class="visual-agent">
                <div class="agent-icon">✦</div>
                <div><small>MCP CLIENT</small><strong>AI Assistant</strong></div>
                <span class="agent-state">已授权</span>
              </div>
              <div class="visual-connector"><span></span><em>OAuth 2.0 / MCP</em><span></span></div>
              <div class="visual-gateway"><span class="gateway-symbol">◇</span><div><small>REMOTE SERVER</small><strong>RCM Server</strong></div><span class="gateway-status">●</span></div>
              <div class="visual-connector"><span></span><em>Outbound WebSocket</em><span></span></div>
              <div class="visual-runtime"><div class="runtime-icon">▣</div><div><small>YOUR LOCAL DEVICE</small><strong>Local Runtime</strong></div><span class="runtime-check">✓</span></div>
              <div class="visual-tools"><span><b>↳</b> file_read</span><span><b>⌁</b> git_diff</span><span><b>›_</b> command_run</span></div>
              <div class="visual-bottom"><span><span class="bottom-indicator"></span> Workspace: authorized</span><span>Local control enabled</span></div>
            </div>
          </div>
        </div>
      </section>

      <div class="proof"><div class="container proof-inner">
        <span>为可控的 AI 开发体验而构建</span>
        <div><span>开放协议</span><span class="proof-mark">✳</span><span>本地优先</span><span class="proof-mark">✳</span><span>授权审批</span><span class="proof-mark">✳</span><span>开源可部署</span></div>
      </div></div>

      <section class="section remote-coding-demo" id="remote-coding-demo">
        <div class="container workflow-grid">
          <div class="workflow-copy">
            <h2>通过远程 MCP<br /><span>修改一个本地文件</span></h2>
            <ol class="demo-steps">
              <li><strong>读取文件。</strong> 在已授权的 AI 工具里调用 <code>file_read</code>，读取测试仓库的 <code>README.md</code>。</li>
              <li><strong>审批修改。</strong> 请 AI 在文件末尾添加「通过远程 MCP 更新」，在 Runtime 核对并批准写入。</li>
              <li><strong>检查差异。</strong> 写入成功后，在同一对话运行 <code>git_diff</code>，查看本地 Git 工作区的变更。</li>
            </ol>
            <a class="text-link" href={clientGuideUrl}>查看接入与验证步骤 <span aria-hidden="true">↗</span></a>
          </div>
          <figure class="demo-result">
            <figcaption><code>git_diff</code><span>README.md</span></figcaption>
            <pre><code>{demoDiff}</code></pre>
            <p>临时 Git 工作区的 Runtime 实测输出摘录。</p>
          </figure>
        </div>
      </section>

      <section class="section capabilities" id="capabilities">
        <div class="container">
          <div class="section-intro"><div><span class="eyeline"><span class="eyeline-mark"></span> PRODUCT CAPABILITIES</span><h2>从对话到代码，<br /><span>把能力连接起来。</span></h2></div><p>不是另一个在线编辑器，而是连接 AI 与真实开发环境的基础设施。让工具调用遵循现有的代码工作方式。</p></div>
          <div class="cap-grid">
            {capabilities.map((item) => (
              <article class="cap-card">
                <div class="cap-card-top"><span>{item.label}</span><span>{item.index} / 04</span></div>
                <div class="cap-icon" aria-hidden="true">
                  {item.icon === 'file' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 3h7l5 5v13H5V3h2Z"/><path d="M14 3v6h5M9 14h6M9 17h6"/></svg>}
                  {item.icon === 'git' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="6" cy="5" r="2.2"/><circle cx="6" cy="19" r="2.2"/><circle cx="18" cy="13" r="2.2"/><path d="M6 7.2v9.6M6 9c0 5 12-1 12 4"/></svg>}
                  {item.icon === 'terminal' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 4 3-4 3M13 16h5"/></svg>}
                  {item.icon === 'shield' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2 4 5v6c0 5 3 9 8 11 5-2 8-6 8-11V5l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>}
                </div>
                <h3>{item.title}</h3><p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section workflow" id="workflow">
        <div class="container workflow-grid">
          <div class="workflow-copy"><span class="eyeline"><span class="eyeline-mark"></span> HOW IT WORKS</span><h2>RCM 如何连接<br /><span>本地工作区？</span></h2><p>Runtime 主动与 Server 建立出站连接，本地工作区不需要开放入站端口。远程身份验证和本地授权检查相互配合。</p><a class="text-link" href={clientGuideUrl}>查看 AI 工具接入指南 <span aria-hidden="true">↗</span></a></div>
          <div class="step-list">{steps.map((step) => <article class="step"><span class="step-index">{step.n}</span><div><h3>{step.title}</h3><p>{step.detail}</p></div><span class="step-arrow" aria-hidden="true">↗</span></article>)}</div>
        </div>
      </section>

      <section class="section ai-clients" id="ai-clients">
        <div class="container">
          <div class="section-intro">
            <div><h2>AI 工具接入</h2></div>
            <p>选择你使用的 AI 工具，按其远程 MCP 接入方式配置 RCM。具体权限和配置入口以客户端版本及账号为准。</p>
          </div>
          <div class="client-grid">
            {clients.map((client) => (
              <article class="client-card">
                <h3>{client.name}</h3>
                <p>{client.detail}</p>
                <a class="text-link" href={client.href}>查看 {client.name} 接入方式 <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section security" id="security">
        <div class="container">
          <div class="security-panel"><div class="security-symbol" aria-hidden="true">◎</div><div class="security-main"><span class="eyeline">DESIGNED FOR CONTROL</span><h2>AI 可以访问<br />哪些本地文件？</h2><p>Server 验证用户、设备和工作区归属；本地 Runtime 再执行读写权限、工具策略与审批规则。文件内容不会作为云端业务数据持久化。</p><p class="security-caution">安全说明：Server 可以接触转发内容；命令按 Runtime 进程账号权限执行，审批不等同于操作系统沙箱。</p><a class="security-link" href={permissionsGuideUrl}>查看工作区权限与数据流向 <span aria-hidden="true">↗</span></a></div><div class="security-decoration" aria-hidden="true"><div class="shield-rings"><div><span>✓</span></div></div><span>AUTHENTICATE → AUTHORIZE → EXECUTE</span></div></div>
        </div>
      </section>

      <section class="section final-cta"><div class="container final-cta-inner"><div><span class="eyeline"><span class="eyeline-mark"></span> GET STARTED</span><h2>部署你自己的<br />Remote Code MCP。</h2><p>用 Docker Compose 部署服务，再从 Runtime 连接本地工作区。</p></div><div class="final-actions"><a href="/docs/deployment.html" class="btn btn-dark">查看 Docker Compose 部署指南 <span aria-hidden="true">↗</span></a>{consoleUrl && <a href={consoleUrl} class="btn btn-outline-dark">前往控制台 <span aria-hidden="true">↗</span></a>}</div></div></section>
    </main>
    <footer class="footer"><div class="container"><div class="footer-primary"><div><a class="wordmark" href="/"><img src="/logo-square.svg" width="33" height="33" alt="" /><span>Remote Code <b>MCP</b></span></a><p>开源、自托管的远程代码 MCP 平台。</p></div><nav aria-label="页脚导航"><a href={docsUrl}>使用文档</a>{consoleUrl && <a href={consoleUrl}>管理控制台</a>}<a href={repositoryUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav></div><div class="footer-legal"><span>© 2026 安阳市思锐科技有限责任公司</span><span>AGPL-3.0-only · Open Source</span></div></div></footer>
  </div>
</BaseLayout>
