{
  "name": "@rcm/runtime",
  "version": "0.3.1",
  "description": "Remote Code MCP 的本机工作区授权与操作运行服务",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aysirui/remote-code-mcp.git",
    "directory": "apps/runtime"
  },
  "homepage": "https://github.com/aysirui/remote-code-mcp#readme",
  "bugs": {
    "url": "https://github.com/aysirui/remote-code-mcp/issues"
  },
  "private": true,
  "scripts": {
    "dev": "pnpm build:web && tsx watch src/main.ts",
    "build": "pnpm build:server && pnpm build:web",
    "start": "node dist/server/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p web/tsconfig.json && tsc -p test/tsconfig.json",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@rcm/protocol": "workspace:*",
    "cross-spawn": "7.0.6",
    "express": "^5.1.0",
    "magic-bytes.js": "^1.13.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "ws": "catalog:",
    "zod": "catalog:",
    "vue": "catalog:",
    "vue-router": "^4.5.0",
    "element-plus": "catalog:",
    "pinia": "catalog:",
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.18.0",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
