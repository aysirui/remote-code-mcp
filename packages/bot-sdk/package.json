{
  "name": "@rcm/bot-sdk",
  "version": "0.1.0",
  "description": "跨平台（飞书、企业微信、钉钉）机器人文本及交互卡片 SDK",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "rcm-bot-demo-feishu": "./bin/feishu.js",
    "rcm-bot-demo-wecom": "./bin/wecom.js",
    "rcm-bot-demo-dingtalk": "./bin/dingtalk.js"
  },
  "exports": {
    "./core": "./dist/core/index.js",
    "./adapters/feishu": "./dist/adapters/feishu/index.js",
    "./adapters/wecom": "./dist/adapters/wecom/index.js",
    "./adapters/dingtalk": "./dist/adapters/dingtalk/index.js",
    "./text": "./dist/core/capabilities/text/index.js",
    "./cards": "./dist/core/capabilities/cards/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "demo:feishu": "tsx src/demo/feishu.ts",
    "demo:wecom": "tsx src/demo/wecom.ts",
    "demo:dingtalk": "tsx src/demo/dingtalk.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@larksuite/channel": "0.7.1",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dingtalk-stream": "2.1.6-beta.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
