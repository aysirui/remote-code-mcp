# Docker Compose 环境变量示例；复制到部署平台环境变量，不要提交真实凭据。
# RCM Server 对外完整 HTTPS 地址，不要附加 /mcp。
PUBLIC_URL=https://rcm.example.com
# Console 管理应用的公开 URL，影响登录和邮箱激活链接。
CONSOLE_URL=https://rcmconsole.example.com
# 产品官网公开 URL，用于生成官网和文档的规范地址、分享信息及 sitemap；两套 Compose 未设置时均回退 PUBLIC_URL。
WEBSITE_URL=https://rcm.example.com
# 在线文档完整公开地址，以 /docs/ 结尾；两套 Compose 默认 WEBSITE_URL/docs/，缺少 WEBSITE_URL 时回退 PUBLIC_URL/docs/。
DOCS_URL=https://rcm.example.com/docs/

# MySQL 业务账号密码（请改为随机强密码）。
MYSQL_PASSWORD=replace-with-random-database-password
# MySQL root 密码，请与业务账号密码区分。
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
# Server 签名密钥，至少 32 字符随机值。
APP_SECRET=replace-with-random-app-secret-at-least-32-chars

# 首次初始化管理员邮箱。
ADMIN_EMAIL=admin@example.com

# OAuth 自定义深链回调规则（可选，JSON 数组）。
# 已内置 WorkBuddy 客户端深链 workbuddy://workbuddy/mcp/，无需额外配置。
# 默认 [] 表示不追加其他规则，不影响内置规则。
# 示例：[{"scheme":"example-ai","hostname":"oauth","pathPrefix":"/callback/"}]
OAUTH_CUSTOM_REDIRECT_RULES=[]

# 注册激活邮件 SMTP 配置，587 推荐 STARTTLS，465 使用隐式 TLS。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-password
# 可选发件地址；为空时 Server 默认使用 SMTP_USER。
MAIL_FROM=notifications@example.com

# 可选：三项均填写才启用飞书审批；使用已发布的企业自建应用及机器人分享链接。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_LINK=

# 可选：企业微信智能机器人的 Bot ID 和长连接 Secret；私聊链接非必填。
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_BOT_LINK=

# 可选：钉钉企业内部应用、企业 ID 和已发布的互动卡片模板。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_CARD_TEMPLATE_ID=
# 默认使用 Client ID；机器人私聊链接非必填。
DINGTALK_ROBOT_CODE=
DINGTALK_BOT_LINK=

# 以下变量由 Compose 自动注入，无需在本文件单独配置：
# VITE_API_URL：Console 构建时使用的 API 地址，来自 PUBLIC_URL。
# VITE_DOCS_URL：Console 文档导航链接，来自 DOCS_URL。
# PUBLIC_SITE_URL：Astro 官网和 VitePress 文档共用的公开站点源地址，来自 WEBSITE_URL，未设置时回退 PUBLIC_URL。
# PUBLIC_CONSOLE_URL：官网和文档的控制台跳转地址，来自 CONSOLE_URL。

# 仅 docker-compose.traefik.yml 使用以下 Host 和 Traefik 设置：
# Host 只填写域名，不含 https://、端口或路径，并与上面的公开 URL 保持一致。
# Server 与官网可共用域名；MCP 根路径 /mcp 和 /mcp/ 下的子路径均转发到 Server。
SERVER_HOST=rcm.example.com
CONSOLE_HOST=rcmconsole.example.com
WEBSITE_HOST=rcm.example.com
# 预先存在的 Traefik 共享 Docker 网络，由部署者自行创建与维护。
TRAEFIK_NETWORK=traefik-public
# Traefik HTTP 入口名；若由 Traefik 自行终止 TLS，需同步配置 TLS 与证书。
TRAEFIK_ENTRYPOINT=web
