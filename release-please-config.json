{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/runtime/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/console/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/website/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/bot-sdk/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/protocol/package.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Bug Fixes",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "Performance",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Refactoring",
          "hidden": true
        }
      ]
    }
  }
}
