{
  "name": "@rcm/runtime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:web && tsx watch src/main.ts",
    "build": "pnpm build:server && pnpm build:web",
    "start": "node dist/server/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p web/tsconfig.json",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@rcm/protocol": "workspace:*",
    "express": "^5.1.0",
    "ws": "catalog:",
    "zod": "catalog:",
    "vue": "catalog:",
    "element-plus": "catalog:",
    "pinia": "catalog:",
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.18.0",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
