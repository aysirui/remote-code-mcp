# Docker Compose 环境变量示例；复制到部署平台环境变量，不要提交真实凭据。
# MySQL 业务账号密码（请改为随机强密码）。
MYSQL_PASSWORD=replace-with-random-database-password
# MySQL root 密码，请与业务账号密码区分。
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
# Server 签名密钥，至少 32 字符随机值。
APP_SECRET=replace-with-random-app-secret-at-least-32-chars
# MCP Gateway 对外完整 HTTPS 地址，不要附加 /mcp。
PUBLIC_URL=https://rcm.example.com
# Console 管理应用的公开 URL，影响登录和邮箱激活链接。
CONSOLE_URL=https://rcmconsole.example.com
# 产品官网公开 URL，用于生成 canonical 与 Open Graph 元数据；未设置时使用 PUBLIC_URL。
WEBSITE_URL=https://rcm.example.com
# 在线文档完整公开地址，以 /docs/ 结尾；未设置时使用 PUBLIC_URL/docs/。
DOCS_URL=https://rcm.example.com/docs/
# 首次初始化管理员邮箱。
ADMIN_EMAIL=admin@example.com
# 注册激活邮件 SMTP 配置，587 推荐 STARTTLS，465 使用隐式 TLS。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-password
# 可选发件地址；为空时 Server 默认使用 SMTP_USER。
MAIL_FROM=notifications@example.com
# 以下变量由 Compose 自动注入，无需在本文件单独配置：
# VITE_API_URL：Console 构建时使用的 API 地址，来自 PUBLIC_URL。
# VITE_DOCS_URL：Console 文档导航链接，来自 DOCS_URL。
# PUBLIC_SITE_URL：Astro 规范站点地址，来自 WEBSITE_URL。
# PUBLIC_CONSOLE_URL：Astro 控制台跳转地址，来自 CONSOLE_URL。
