# 第一阶段：安装官网构建依赖，生成不依赖 Node.js 运行时的静态页面。
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN corepack enable
# 复制 workspace 清单和锁文件，确保使用仓库锁定的依赖版本。
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/tsconfig packages/tsconfig
COPY apps/server/package.json apps/server/package.json
COPY apps/console/package.json apps/console/package.json
COPY apps/runtime/package.json apps/runtime/package.json
COPY apps/website/package.json apps/website/package.json
COPY packages/protocol/package.json packages/protocol/package.json
RUN pnpm --filter @rcm/website... install --frozen-lockfile
# 官网只读取自身源码；公开站点 URL 用于生成 canonical 元数据。
COPY apps/website apps/website
# 共用控制台现有 Logo 源文件，避免生成两份品牌资源。
COPY apps/console/public/remote-code-logo.png apps/console/public/remote-code-logo.png
ARG PUBLIC_SITE_URL
ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL}
ARG PUBLIC_CONSOLE_URL
ENV PUBLIC_CONSOLE_URL=${PUBLIC_CONSOLE_URL}
RUN pnpm --filter @rcm/website build

# 第二阶段：只发布静态文件，不保留 Node.js、依赖和源代码。
FROM nginx:alpine
COPY LICENSE /usr/share/doc/remote-code-mcp/LICENSE
COPY --from=builder /app/apps/website/dist/ /usr/share/nginx/html/
COPY docker/nginx.website.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
