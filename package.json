{
  "name": "remote-code-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "通过远程 Gateway 安全访问本机授权代码工作区的 MCP 服务",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aysirui/remote-code-mcp.git"
  },
  "homepage": "https://github.com/aysirui/remote-code-mcp#readme",
  "bugs": {
    "url": "https://github.com/aysirui/remote-code-mcp/issues"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @rcm/protocol build && pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "dev:server": "pnpm --filter @rcm/server dev",
    "dev:console": "pnpm --filter @rcm/console dev",
    "dev:runtime": "pnpm --filter @rcm/runtime dev",
    "build": "pnpm -r --sort build && pnpm docs:build",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5174 --strictPort",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 5174",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @rcm/server db:generate",
    "db:migrate": "pnpm --filter @rcm/server db:migrate",
    "admin:init": "pnpm --filter @rcm/server admin:init"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vue": "catalog:"
  }
}
